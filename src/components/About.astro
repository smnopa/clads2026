---
---

<section id="about" class="relative py-32 bg-white overflow-hidden">
  <div class="orb w-[500px] h-[500px] bg-brand-blue/5 top-0 left-[-200px]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <div>
        <div class="reveal">
          <span class="section-label">Sobre el congreso</span>
          <h2 class="font-display text-4xl sm:text-5xl leading-tight mt-4 mb-6 text-slate-900">
            Donde los sistemas<br/>
            <span class="gradient-text-blue">moldean el futuro</span>
          </h2>
        </div>

        <div class="reveal reveal-delay-1 space-y-5 text-slate-600 leading-relaxed">
          <p>
            <strong class="text-slate-900 font-medium">CLADS 2026</strong> es el evento más importante de Dinámica de Sistemas en Latinoamérica, diseñado para fortalecer la comunidad académica, impulsar nuevas investigaciones y generar soluciones a problemáticas complejas en contextos sociales, organizacionales y ambientales.
          </p>
          <p>
            Este congreso reúne a expertos, investigadores y estudiantes en un entorno que favorece el intercambio de conocimiento, la innovación y la colaboración interdisciplinaria a nivel regional e internacional.
          </p>
        </div>

        <div class="reveal reveal-delay-2 mt-10 grid grid-cols-2 gap-4">
          {[
            {
              icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
              title: 'Comunidad primero',
              desc: 'Red latinoamericana activa y colaborativa',
            },
            {
              icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
              title: 'Eje de innovación',
              desc: 'Soluciones a desafíos reales y complejos',
            },
            {
              icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
              title: 'Alcance global',
              desc: 'Colaboración internacional e interinstitucional',
            },
            {
              icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>`,
              title: 'Nuevas generaciones',
              desc: 'Formación de nuevas generaciones',
            },
          ].map((item) => (
            <div class="glass glass-hover rounded-xl p-4 card-shine">
              <div class="text-brand-blue mb-3" set:html={item.icon}></div>
              <div class="font-semibold text-sm text-slate-900 mb-1">{item.title}</div>
              <div class="text-slate-500 text-xs leading-snug">{item.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal reveal-delay-2 relative">
        <div class="relative rounded-2xl overflow-hidden aspect-[4/5] glass border border-slate-200">
          <img
            src="https://industrial.univalle.edu.co/images/Eventos/FOTO1_1.png"
            alt="Espacio de conferencias académicas — imagen referencial"
            class="w-full h-full object-cover opacity-90"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-white/50 to-transparent"></div>

          <div class="absolute bottom-6 left-6 right-6">
            <div class="glass rounded-xl p-4">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-2 h-2 rounded-full bg-brand-blue animate-pulse"></div>
                <span class="font-mono text-xs text-brand-blue-dark tracking-widest uppercase">Abierto</span>
              </div>
              <p class="font-display text-slate-900 text-sm">Recepción de resúmenes</p>
              <p class="text-slate-500 text-xs mt-1">Fecha límite: 31 de junio de 2026</p>
            </div>
          </div>
        </div>

        <div class="absolute -top-4 -right-4 w-32 h-32 rounded-full border border-brand-blue/20 animate-spin-slow"></div>
        <div class="absolute -bottom-4 -left-4 w-20 h-20 rounded-full border border-brand-blue-dark/20 animate-spin-slow" style="animation-direction: reverse"></div>
      </div>
    </div>

    <div class="mt-24 reveal">
      <div class="grid md:grid-cols-5 gap-6">
        {[
          {
            num: '01',
            title: 'Fortalecer la comunidad latinoamericana',
            desc: 'Red activa, colaborativa y sostenible en torno a la Dinámica de Sistemas.',
          },
          {
            num: '02',
            title: 'Promover aplicaciones innovadoras',
            desc: 'Fomentar soluciones con impacto en contextos organizacionales, sociales y ambientales.',
          },
          {
            num: '03',
            title: 'Diálogo interdisciplinario',
            desc: 'Espacios donde converjan diversas áreas del conocimiento.',
          },
          {
            num: '04',
            title: 'Colaboración internacional',
            desc: 'Integración de actores de distintos países e instituciones.',
          },
          {
            num: '05',
            title: 'Nuevas generaciones',
            desc: 'Espacios de aprendizaje y retroalimentación para estudiantes de maestría y doctorado.',
          },
        ].map((obj, i) => (
          <div class={`glass glass-hover rounded-xl p-6 card-shine reveal reveal-delay-${i + 1}`}>
            <div class="font-mono text-brand-blue/40 text-2xl font-bold mb-4">{obj.num}</div>
            <h3 class="font-semibold text-slate-900 text-sm leading-tight mb-3">{obj.title}</h3>
            <p class="text-slate-500 text-xs leading-relaxed">{obj.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
