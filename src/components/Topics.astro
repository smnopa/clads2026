---

<section id="topics" class="relative py-32 bg-white overflow-hidden">
  <div class="orb w-[600px] h-[600px] bg-brand-blue/5 bottom-0 right-0"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="text-center mb-20">
      <div class="reveal">
        <span class="section-label">Llamado a ponencias</span>
        <h2 class="font-display text-4xl sm:text-5xl mt-4 text-slate-900">
          Áreas <span class="gradient-text">temáticas</span>
        </h2>
        <p class="text-slate-500 mt-4 max-w-xl mx-auto text-sm leading-relaxed font-normal">
          Envía tu investigación en cualquiera de las siguientes áreas. Recibimos aportes teóricos y estudios aplicados.
        </p>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
      {topics.map((topic, i) => (
        <div
          class={`reveal reveal-delay-${(i % 5) + 1} relative rounded-xl overflow-hidden glass glass-hover card-shine group cursor-pointer`}
        >
          <div class={`absolute inset-0 bg-gradient-to-br ${topic.color} to-transparent opacity-60 pointer-events-none`}></div>
          <div class="relative p-6 flex items-start gap-4">
            <div
              class="shrink-0 w-10 h-10 rounded-lg flex items-center justify-center"
              style={`background: ${topic.accent}22; color: ${topic.accent};`}
            >
              <span set:html={topic.icon} />
            </div>
            <div class="flex-1 min-w-0">
              <span
                class="font-mono text-xs tracking-widest uppercase mb-2 block"
                style={`color: ${topic.accent}; opacity: 0.9`}
              >
                {topic.tag}
              </span>
              <h3 class="font-semibold text-sm leading-snug text-slate-900">
                {topic.title}
              </h3>
            </div>
            <svg class="w-4 h-4 text-slate-300 group-hover:text-brand-blue group-hover:translate-x-1 transition-all shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      ))}
    </div>

    <div class="reveal">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="glass rounded-2xl p-8 border border-brand-blue/20">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-brand-blue-light/15 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-brand-blue-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-display text-slate-900 text-lg">Resumen (obligatorio)</h3>
              <p class="text-brand-blue-dark text-sm font-mono">Tipo de envío 1</p>
            </div>
          </div>
          <ul class="space-y-2 text-slate-600 text-sm font-normal">
            <li class="flex items-center gap-2"><span class="text-brand-blue">→</span> Máximo 1 página</li>
            <li class="flex items-center gap-2"><span class="text-brand-blue">→</span> Incluye problema, metodología y aportes</li>
            <li class="flex items-center gap-2"><span class="text-brand-blue">→</span> Requerido para todos los participantes</li>
          </ul>
        </div>

        <div class="glass rounded-2xl p-8 border border-brand-blue-dark/25">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-brand-blue-dark/10 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-brand-blue-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div>
              <h3 class="font-display text-slate-900 text-lg">Trabajo completo (opcional)</h3>
              <p class="text-brand-blue-dark text-sm font-mono">Tipo de envío 2</p>
            </div>
          </div>
          <ul class="space-y-2 text-slate-600 text-sm font-normal">
            <li class="flex items-center gap-2"><span class="text-brand-blue-dark">→</span> Mínimo 6 páginas</li>
            <li class="flex items-center gap-2"><span class="text-brand-blue-dark">→</span> Para publicación en memorias del congreso</li>
            <li class="flex items-center gap-2"><span class="text-brand-blue-dark">→</span> Opción de publicación extendida</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
