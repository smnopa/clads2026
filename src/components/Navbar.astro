---
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-4 bg-white/92 backdrop-blur-xl border-b border-slate-900/8 shadow-[0_4px_24px_rgba(15,23,42,0.06)]"
>
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    <a href="#hero" class="flex items-center gap-3 group">
      <div class="w-8 h-8 rounded-sm bg-gradient-to-br from-brand-blue-light to-brand-blue-dark flex items-center justify-center shadow-sm">
        <span class="font-display not-italic text-[0.65rem] text-white leading-none">CL</span>
      </div>
      <div>
        <span class="font-display text-slate-900 text-sm tracking-wider">CLADS</span>
        <span class="font-mono text-brand-blue-dark text-xs ml-1 opacity-90">2026</span>
      </div>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {[
        { label: 'Acerca de', href: '#about' },
        { label: 'Agenda', href: '#agenda' },
        { label: 'Temas', href: '#topics' },
        { label: 'Cronograma', href: '#timeline' },
        { label: 'Sede', href: '#venue' },
      ].map((item) => (
        <a
          href={item.href}
          class="text-xs font-medium tracking-widest uppercase text-slate-500 hover:text-brand-blue transition-colors duration-200"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="hidden md:flex items-center gap-3">
      <a href="#contact" class="btn-outline text-xs py-2 px-4">Contacto</a>
      <a href="#register" class="btn-primary text-xs py-2 px-4">Inscribirse</a>
    </div>

    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Menú"
    >
      <span class="w-6 h-px bg-slate-800 block"></span>
      <span class="w-4 h-px bg-brand-blue block"></span>
      <span class="w-6 h-px bg-slate-800 block"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden mt-4 mx-6 glass rounded-lg p-6 space-y-4"
  >
    {[
      { label: 'Acerca de', href: '#about' },
      { label: 'Agenda', href: '#agenda' },
      { label: 'Temas', href: '#topics' },
      { label: 'Cronograma', href: '#timeline' },
      { label: 'Sede', href: '#venue' },
    ].map((item) => (
      <a
        href={item.href}
        class="block text-sm font-medium tracking-widest uppercase text-slate-600 hover:text-brand-blue transition-colors"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-4 border-t border-slate-200 flex flex-col gap-3">
      <a href="#contact" class="btn-outline text-center text-xs py-2">Contacto</a>
      <a href="#register" class="btn-primary text-center text-xs py-2">Inscribirse</a>
    </div>
  </div>
</nav>
