---
---

<section id="contact" class="relative py-24 bg-white border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-3 gap-12 mb-16">
      <div class="reveal lg:col-span-1">
        <a href="#hero" class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-sm bg-gradient-to-br from-brand-sky to-brand-cyan flex items-center justify-center">
            <span class="font-display font-bold text-sm text-white">CL</span>
          </div>
          <div>
            <span class="font-display font-bold text-slate-900 text-lg tracking-wider">CLADS</span>
            <span class="font-mono text-brand-cyan text-sm ml-1 opacity-80">2026</span>
          </div>
        </a>
        <p class="text-slate-500 text-sm leading-relaxed mb-6">
          XXIV Congreso Latinoamericano de Dinámica de Sistemas. Santiago de Chile, 7–9 de octubre de 2026.
        </p>
        <div class="flex gap-3">
          {['X (Twitter)', 'LinkedIn', 'Correo'].map((social) => (
            <a
              href="#"
              class="glass rounded-lg px-3 py-2 text-slate-500 hover:text-brand-sky text-xs font-mono transition-colors border border-slate-200 hover:border-brand-sky/40"
            >
              {social}
            </a>
          ))}
        </div>
      </div>

      <div class="reveal reveal-delay-1 grid grid-cols-2 gap-8 lg:col-span-2">
        <div>
          <h4 class="font-display font-semibold text-slate-900 text-sm mb-4 tracking-widest uppercase">Congreso</h4>
          <ul class="space-y-2">
            {[
              { label: 'Acerca de CLADS', href: '#about' },
              { label: 'Agenda', href: '#agenda' },
              { label: 'Áreas temáticas', href: '#topics' },
              { label: 'Sede', href: '#venue' },
              { label: 'Patrocinadores', href: '#' },
            ].map((item) => (
              <li>
                <a href={item.href} class="text-slate-500 hover:text-brand-sky text-sm transition-colors">{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h4 class="font-display font-semibold text-slate-900 text-sm mb-4 tracking-widest uppercase">Participación</h4>
          <ul class="space-y-2">
            {[
              { label: 'Enviar resumen', href: '#register' },
              { label: 'Inscripción', href: '#register' },
              { label: 'Llamado a ponencias', href: '#topics' },
              { label: 'Coloquio doctoral', href: '#agenda' },
              { label: 'Contacto', href: '#contact' },
            ].map((item) => (
              <li>
                <a href={item.href} class="text-slate-500 hover:text-brand-sky text-sm transition-colors">{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-slate-400 text-xs font-mono">
        © 2026 CLADS — Congreso Latinoamericano de Dinámica de Sistemas
      </p>
      <p class="text-slate-400 text-xs font-mono">
        Santiago · Chile · 7–9 de octubre
      </p>
    </div>
  </div>
</section>
